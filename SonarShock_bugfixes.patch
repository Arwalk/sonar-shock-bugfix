+# ---- SONAR PATCH: bounded decal registry ----
+# Decals/casings/blood are parented to the tree root and, with the "OFF" decal
+# lifetime (>= 90), never freed themselves. Each decal registers here from its
+# _ready; beyond the per-category cap the oldest one is freed, which bounds the
+# session-long node growth that degraded performance over time.
+const SP_DECAL_CAPS = {"bullethole": 300, "blood": 250, "casing": 150}
+var sp_decals = {"bullethole": [], "blood": [], "casing": []}
+
+func register_decal(node: Node, category: String) -> void:
+	if not sp_decals.has(category):
+		category = "bullethole"
+	var arr: Array = sp_decals[category]
+	arr.append(node)
+	for i in range(arr.size() - 1, -1, -1):
+		if not is_instance_valid(arr[i]):
+			arr.remove_at(i)
+	while arr.size() > SP_DECAL_CAPS[category]:
+		var oldest = arr.pop_front()
+		if is_instance_valid(oldest):
+			oldest.queue_free()
