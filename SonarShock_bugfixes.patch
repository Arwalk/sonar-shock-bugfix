@@ -53,6 +53,30 @@ func _ready():
 	if new_manager.quest3_1 == 0:
 		$NavigationRegion3D/map3_geo/layer_1_open.position.y = - 1000
 
+	# ---- SONAR PATCH: floor-3 stutter fixes ----
+	# The security-monitor screen (objects/Camera2) autoplays a 1314-frame
+	# SpriteFrames "video" at 45 fps with no culling, swapping GPU textures
+	# every ~22 ms forever. Pause it whenever it is not on screen.
+	var cam_screen = get_node_or_null("NavigationRegion3D/objects/Camera2/AnimatedSprite3D")
+	if cam_screen != null:
+		var vis_check = VisibleOnScreenNotifier3D.new()
+		vis_check.aabb = AABB(Vector3(-0.6, -0.6, -0.6), Vector3(1.2, 1.2, 1.2))
+		vis_check.screen_entered.connect(cam_screen.play)
+		vis_check.screen_exited.connect(cam_screen.pause)
+		cam_screen.add_child(vis_check)
+		cam_screen.pause()
+
+	# Best-effort prewarm of the crypt/cyber threshold rendering state
+	# (trigger_cyber toggles LightmapGI + fog, which can stall on first-use
+	# shader variants). Applied for two frames while the elevator still hides
+	# the world; harmless no-op if nothing renders during load.
+	$WorldEnvironment.environment.fog_enabled = false
+	$LightmapGI.hide()
+	await get_tree().process_frame
+	await get_tree().process_frame
+	$LightmapGI.show()
+	$WorldEnvironment.environment.fog_enabled = true
