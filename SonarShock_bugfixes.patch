+	for t in range(anim.get_track_count() - 1, -1, -1):
+		var p: NodePath = anim.track_get_path(t)
+		if p.get_name_count() > 0 and String(p.get_name(p.get_name_count() - 1)) == "body":
+			anim.remove_track(t)
+
+func sp_can_stand() -> bool:
+	var w = get_world_3d()
+	if w == null or w.direct_space_state == null:
+		return not $crouch_check.is_colliding()
+	var shape = CapsuleShape3D.new()
+	shape.radius = 0.48
+	shape.height = 1.9
+	var params = PhysicsShapeQueryParameters3D.new()
+	params.shape = shape
+	params.transform = global_transform * Transform3D(Basis(), Vector3(0, 2.0 - shape.height * 0.5, 0))
+	params.collision_mask = collision_mask
+	params.exclude = [get_rid()]
+	return w.direct_space_state.intersect_shape(params, 1).is_empty()
+
+func sp_is_embedded_from_above() -> bool:
+	var params = PhysicsTestMotionParameters3D.new()
+	params.from = global_transform
+	params.motion = Vector3.ZERO
+	params.recovery_as_collision = true
+	var result = PhysicsTestMotionResult3D.new()
+	if not PhysicsServer3D.body_test_motion(get_rid(), params, result):
+		return false
+	for i in range(result.get_collision_count()):
+		if result.get_collision_normal(i).y < -0.6 and result.get_collision_depth(i) > 0.08:
+			return true
+	return false
+
+func sp_force_crouch() -> void:
+	crouch = true
+	SPEED = 3
+	$health/body.animation = "crouch"
+	$crouch.play("new_animation")
+	sp_apply_crouch_shape(true)
+
+# ---- SONAR PATCH: item placement fix ----
+# The shipped drop/throw check used a fixed 0.65 Area3D cube 0.65m below the
+# camera: crouching sank it into the floor (guaranteed "Not enough space."
+# softlock — barrels/mines can't be thrown either), and its size matched no
+# carried item. Replaced with a direct-space query sized per item, anchored
+# just above the spawn point. The forward item_spawn_check ray is kept so a
+# point-blank wall still denies (and throws can't spawn beyond a wall).
+
+func sp_can_place(check_volume: bool) -> bool:
+	var blocked = $head/Camera3D/lighter_vis/spawner/item_spawn_check.is_colliding()
+	if not blocked and check_volume:
+		var w = get_world_3d()
+		if w == null or w.direct_space_state == null:
+			for body11 in $head/Camera3D/lighter_vis/spawner/Area3D.get_overlapping_bodies():
+				if body11 != null and body11 != self:
+					blocked = true
+		else:
+			var shape = CylinderShape3D.new()
+			if pickedup_item == 2:      # barrel: real collider r~0.45 h~1.12 above origin
+				shape.radius = 0.4
+				shape.height = 1.0
+			elif pickedup_item == 1:    # crate
+				shape.radius = 0.35
+				shape.height = 0.6
+			else:                        # fire ext / flare / soma mine
+				shape.radius = 0.25
+				shape.height = 0.4
+			var params = PhysicsShapeQueryParameters3D.new()
+			params.shape = shape
+			var origin = $head/Camera3D/lighter_vis/spawner.global_transform.origin
+			origin.y += shape.height * 0.5 + 0.06
+			params.transform = Transform3D(Basis(), origin)
+			params.collision_mask = 1
+			params.exclude = [get_rid()]
+			blocked = not w.direct_space_state.intersect_shape(params, 1).is_empty()
+	if blocked:
+		if not $denied.playing:
+			$denied.play()
+		$info3.text = "Not enough space."
+		$info_num.text = " "
+	return not blocked
