+
+# ---- SONAR PATCH: crouch collision fixes ----
+# The shipped game shrank the capsule by animating a non-uniform scale on the
+# "body" CollisionShape3D (unsupported by Godot physics) and gated standing up
+# on a single center ray, so standing under a partial overhang embedded the
+# player in geometry. The collider is now resized in code, standing clearance
+# uses a full capsule query, and a watchdog un-wedges an embedded player.
+
+var sp_embed_frame_counter = 0
+
+func sp_apply_crouch_shape(is_crouched: bool) -> void:
+	var cs = get_node_or_null("body")
+	if cs == null or not (cs.shape is CapsuleShape3D):
+		return
+	cs.scale = Vector3.ONE
+	if is_crouched:
+		cs.shape.height = 1.0
+		cs.position.y = 0.5118
+	else:
+		cs.shape.height = 2.0
+		cs.position.y = 1.0
+
+func sp_patch_crouch_animation() -> void:
+	var cs = get_node_or_null("body")
+	if cs != null and cs.shape != null:
+		cs.shape = cs.shape.duplicate()
+	var ap = get_node_or_null("crouch")
+	if ap == null:
+		return
+	var anim: Animation = ap.get_animation("new_animation")
+	if anim == null:
+		return
+	for t in range(anim.get_track_count() - 1, -1, -1):
+		var p: NodePath = anim.track_get_path(t)
+		if p.get_name_count() > 0 and String(p.get_name(p.get_name_count() - 1)) == "body":
+			anim.remove_track(t)
+
+func sp_can_stand() -> bool:
+	var w = get_world_3d()
+	if w == null or w.direct_space_state == null:
+		return not $crouch_check.is_colliding()
+	var shape = CapsuleShape3D.new()
+	shape.radius = 0.48
+	shape.height = 1.9
+	var params = PhysicsShapeQueryParameters3D.new()
+	params.shape = shape
+	params.transform = global_transform * Transform3D(Basis(), Vector3(0, 2.0 - shape.height * 0.5, 0))
+	params.collision_mask = collision_mask
+	params.exclude = [get_rid()]
+	return w.direct_space_state.intersect_shape(params, 1).is_empty()
+
+func sp_is_embedded_from_above() -> bool:
+	var params = PhysicsTestMotionParameters3D.new()
+	params.from = global_transform
+	params.motion = Vector3.ZERO
+	params.recovery_as_collision = true
+	var result = PhysicsTestMotionResult3D.new()
+	if not PhysicsServer3D.body_test_motion(get_rid(), params, result):
+		return false
+	for i in range(result.get_collision_count()):
+		if result.get_collision_normal(i).y < -0.6 and result.get_collision_depth(i) > 0.08:
+			return true
+	return false
+
+func sp_force_crouch() -> void:
+	crouch = true
+	SPEED = 3
+	$health/body.animation = "crouch"
+	$crouch.play("new_animation")
+	sp_apply_crouch_shape(true)
